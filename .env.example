# THSR Ticket Manager - Environment Variables Template
# Copy this file to `.env` and fill in the values for your machine.
# `.env` is gitignored and stays local.

# Local absolute path to this project directory.
# Used in the "download receipt" flow: the copied command starts with
# `cd <VITE_PROJECT_DIR>` so the user can paste + run in any shell.
# Example (Windows): C:\Users\yourname\code\THSR-Ticket-Manager
# Example (macOS/Linux): /Users/yourname/code/THSR-Ticket-Manager
# Leave empty if you don't want the `cd` line in the copied command.
VITE_PROJECT_DIR=
